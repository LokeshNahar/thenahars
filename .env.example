# Firebase is inert until this is "true" and real values are supplied below
# (in a git-ignored .env.local, never committed).
#
# Each branch points at its own Firebase project's config:
#   dev branch  -> thenahars-dev
#   uat branch  -> thenahars-uat
#   main branch -> thenahars-prod (injected via GitHub Actions secrets at
#                  build time, not a committed/local .env file — see
#                  .github/workflows/deploy.yml)
#
# Storage is intentionally not configured — it requires the Blaze plan and
# nothing in the app needs it yet (photo is a plain URL string field).
VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
