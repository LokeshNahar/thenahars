# Firebase is inert until this is "true" and real values are supplied below
# (in a git-ignored .env.local, never committed).
#
# Each branch points at its own Firebase project's config:
#   dev branch  -> thenahars-dev
#   uat branch  -> thenahars-uat
#   main branch -> thenahars-prod (injected via GitHub Actions secrets at
#                  build time, not a committed/local .env file — see
#                  .github/workflows/deploy.yml)
#
# Storage is intentionally not configured — it requires the Blaze plan and
# nothing in the app needs it yet (photo is a plain URL string field).
VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — App Check (free on Spark). Leave blank to skip; the app runs
# fine without it, just without the extra "is this really the real app"
# check on Firestore/Auth requests. To enable:
#   1. Firebase Console -> App Check -> Apps -> (this web app) -> register
#      a reCAPTCHA v3 provider, and paste its site key below.
#   2. Still in App Check, leave Firestore/Auth enforcement OFF at first —
#      that's the default. With a site key set but enforcement off, the
#      app attaches App Check tokens and you can watch verified vs.
#      unverified request metrics in the Console before ever blocking
#      anyone.
#   3. Only flip enforcement to ON once you've confirmed real traffic
#      (your own signed-in usage) is showing as verified — otherwise you
#      risk locking out real users.
VITE_RECAPTCHA_SITE_KEY=
