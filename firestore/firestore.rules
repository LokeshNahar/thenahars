// Deployed rules. See PHASE2-PLAN.md, PHASE2-ADD-PERSON-PLAN.md, and
// SECURITY-PRIVATE-SPLIT.md for the full design rationale.
//
// PRIVACY BOUNDARY (read this first): `people/{naharId}` is PUBLIC to any
// signed-in visitor — it holds name/relationships/status only, nothing
// sensitive. Every field that could identify or contact someone in the
// real world (phone, email, date of birth, marriage date, location,
// profession, qualification, photo, socials, notes) lives instead in the
// `people/{naharId}/private/details` subcollection, which only an admin or
// any matched member (a signed-in visitor whose own email resolves to a
// Person via people_by_email) may read. An anonymous visitor, or a
// signed-in visitor who has never been approved, gets the public shape
// only — never the private one. This split exists because Firestore rules
// can't hide individual fields within one document read; splitting into
// two documents is the only way to actually enforce "structure is public,
// contact details are not" at the database level, rather than trusting
// the UI to hide fields it already received.
//
// Model:
//   - `people/{naharId}` mirrors PublicPerson in src/data/schema.ts.
//   - `people/{naharId}/private/details` mirrors PrivatePersonDetails.
//   - `people_by_email/{emailLowercased}` is a denormalized lookup doc
//     `{ nahar_id }`, kept in sync by the app itself (writeBatch/transaction)
//     whenever a person's email changes or a new person is created — no
//     Cloud Function. Writes are validated so a client can't forge a
//     lookup pointing at someone else's identity. Readable only by an
//     admin or the account whose own email it is — nobody needs to read
//     someone ELSE's email-to-id mapping client-side, and that mapping is
//     itself a list of real email addresses, which is exactly the kind of
//     thing a scraper would want.
//   - `meta/id_counter` reserves collision-safe sequential "N-00xx" ids via
//     a client-side Firestore transaction.
//   - A signed-in member may write PERSONAL fields only (phone, email,
//     dateOfBirth, marriageDate, profession, qualification, location,
//     photo, instagram, facebook, linkedin, notes — the private-subdoc
//     fields; `name` and `status` stay on the public doc and are edited
//     there) on: their own record, their parents'/spouse's/children's
//     records, or the root of a linked external family they connect
//     through (linkedFamilyOf == their id).
//   - A signed-in member may CREATE a new person anchored on anyone they
//     can already edit (self/immediate relative/linked-family root) —
//     claiming exactly one relationship (parent, spouse, or child) to that
//     anchor, or creating a linked-family root off that anchor. This is
//     how arbitrarily deep chains (grandchild, great-grandchild, a child's
//     spouse, a sibling via a shared parent's page, ...) stay correct
//     without recursion in rules: each addition is anchored on the actual
//     intermediate person's own record. The client writes both the public
//     doc and its private/details subdoc as two separate, sequential
//     writes (never the same atomic commit — a rule's get()/exists() can't
//     see another write from the same commit, so this was always true even
//     before the private split, see PHASE2-ADD-PERSON-PLAN.md).
//   - A signed-in member may then splice that brand-new person into their
//     own (or the anchor's) parents/spouse/children array — but ONLY as a
//     single addition of a person whose addedBy is themself, never a
//     re-link of two pre-existing people. Re-linking existing people, and
//     any other relationship-array change, stays admin-only.
//   - role == "admin" may write anything on any record (public or
//     private), including the relationship arrays (parents/spouse/
//     children), nahar_id, claimed, role, isBloodline, and can
//     create/delete freely.
//   - isBloodline marks whether a person was born a Nahar (their own
//     parents-if-added extend the MAIN tree) vs. married in from outside
//     (their own parents-if-added must form a linked EXTERNAL branch
//     instead). A non-admin's "add parent" create is only valid when the
//     anchor is bloodline; a married-in anchor's "add parent" must go
//     through the linked-family-root path. Never a personal field — only
//     admins can change it after creation.
//   - `pending_claims/{emailLowercased}` is a self-claim request queue: a
//     signed-in-but-unmatched visitor submits their name + both parents'
//     names, the client suggests a matching nahar_id, and an admin reviews
//     and approves/rejects in AdminPage (approval then does the existing
//     people_by_email link — this collection has no rights of its own).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth != null ? request.auth.token.email.lower() : null;
    }

    function callerPerson() {
      let email = signedInEmail();
      return email != null && exists(/databases/$(database)/documents/people_by_email/$(email))
        ? get(/databases/$(database)/documents/people/
            $(get(/databases/$(database)/documents/people_by_email/$(email)).data.nahar_id)
          ).data
        : null;
    }

    function isAdmin() {
      let me = callerPerson();
      return me != null && me.role == 'admin';
    }

    function isSelf(targetId) {
      let me = callerPerson();
      return me != null && me.nahar_id == targetId;
    }

    function isImmediateRelative(target) {
      let me = callerPerson();
      return me != null && (
        target.nahar_id in me.spouse ||
        me.nahar_id in target.spouse ||
        me.nahar_id in target.parents ||   // target is my child
        target.nahar_id in me.parents ||   // target is my parent
        // target is the root of a linked external family I connect through
        // (e.g. my own mother's birth family) — grants management rights
        // over that whole branch to the connecting person and anyone who
        // can already edit them.
        target.linkedFamilyOf == me.nahar_id
      );
    }

    function canEditPerson(targetId, target) {
      return isAdmin() || isSelf(targetId) || isImmediateRelative(target);
    }

    // The public doc's only non-admin-editable fields are `name` and
    // `status` — the two PersonEditForm fields that were never sensitive
    // and so stay on the public doc rather than moving to private/details.
    function onlyPublicPersonalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status']);
    }

    // Every field on the private/details subdoc is self-service-editable
    // by whoever can already edit the parent Person.
    function onlyPrivateFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'phone', 'dateOfBirth', 'marriageDate', 'email', 'profession', 'qualification', 'location',
        'photo', 'instagram', 'facebook', 'linkedin', 'notes'
      ]);
    }

    // Baseline shape every non-admin-created person must satisfy, regardless
    // of which relationship is being claimed below.
    function newPersonBaseShapeIsValid(naharId, data) {
      let me = callerPerson();
      return me != null
        && data.nahar_id == naharId
        && data.role == 'member'
        && data.claimed == false
        && data.addedBy == me.nahar_id
        && data.addedAt == request.time
        && data.isBloodline is bool;
    }

    // Case: caller adds THEIR OWN parent (or a relative-they-can-edit's
    // parent — e.g. their spouse's parent). New person's `children` must
    // contain the anchor's id; no spouse/other children claimed yet. Only
    // valid when the anchor is themself Nahar bloodline — a married-in
    // person's own parents must go through newLinkedFamilyRootIsValid
    // instead, so they land in a separate branch rather than polluting the
    // main tree. The new parent inherits isBloodline == true (they extend
    // the same blood line upward).
    function newParentIsValid(data) {
      return data.children.size() == 1
        && callerIsRelatedToAnchor(data.children[0])
        && get(/databases/$(database)/documents/people/$(data.children[0])).data.isBloodline == true
        && data.parents.size() == 0
        && data.spouse.size() == 0
        && data.linkedFamilyOf == null
        && data.isBloodline == true;
    }

    // Case: caller adds a spouse to themself or any editable relative. A
    // spouse married in from outside is never bloodline, regardless of the
    // anchor's own status — this is deliberately NOT auto-derived, so the
    // client must pass isBloodline == false explicitly here.
    function newSpouseIsValid(data) {
      return data.spouse.size() == 1
        && callerIsRelatedToAnchor(data.spouse[0])
        && data.parents.size() == 0
        && data.children.size() == 0
        && data.linkedFamilyOf == null
        && data.isBloodline == false;
    }

    // Case: caller adds a child (or grandchild, by acting from that
    // child's own page) of themself or any editable relative. Up to two
    // parents may be listed (co-parent convenience), but at least one
    // must be an anchor the caller can edit. A child of a bloodline parent
    // is bloodline; a child added under a linked-external-family branch
    // (neither parent bloodline, or the anchor is itself non-bloodline)
    // stays non-bloodline — isBloodline always means "born a Nahar," never
    // "primary line within whichever branch we're currently viewing."
    function newChildIsValid(data) {
      return data.parents.size() >= 1 && data.parents.size() <= 2
        && (callerIsRelatedToAnchor(data.parents[0])
            || (data.parents.size() == 2 && callerIsRelatedToAnchor(data.parents[1])))
        && data.spouse.size() == 0
        && data.children.size() == 0
        && data.linkedFamilyOf == null
        && data.isBloodline == anyParentIsBloodline(data.parents);
    }

    function anyParentIsBloodline(parentIds) {
      return parentIds.size() > 0 && (
        (exists(/databases/$(database)/documents/people/$(parentIds[0]))
          && get(/databases/$(database)/documents/people/$(parentIds[0])).data.isBloodline == true)
        || (parentIds.size() == 2
            && exists(/databases/$(database)/documents/people/$(parentIds[1]))
            && get(/databases/$(database)/documents/people/$(parentIds[1])).data.isBloodline == true)
      );
    }

    // Case: caller creates the root of a linked EXTERNAL family (e.g. their
    // own mother's birth family), anchored on a person they can already
    // edit. No relationship arrays — that's the whole point. Never
    // bloodline — it exists precisely because the anchor married in.
    function newLinkedFamilyRootIsValid(data) {
      return data.parents.size() == 0
        && data.spouse.size() == 0
        && data.children.size() == 0
        && data.linkedFamilyOf != null
        && callerIsRelatedToAnchor(data.linkedFamilyOf)
        && data.linkedFamilyLabel is string
        && data.linkedFamilyLabel.size() > 0
        && data.isBloodline == false;
    }

    // True if the caller can already edit the given anchor person — i.e.
    // the new record's claimed relationship attaches to someone the caller
    // has real standing over. This is the boundary that makes arbitrarily
    // deep chains (grandchild, great-grandchild, ...) work correctly: each
    // addition is anchored on the actual intermediate person's own record,
    // never jumped in one step.
    function callerIsRelatedToAnchor(anchorId) {
      return anchorId != null
        && exists(/databases/$(database)/documents/people/$(anchorId))
        && canEditPerson(anchorId, get(/databases/$(database)/documents/people/$(anchorId)).data);
    }

    // Adds (never removes/reorders) exactly one id to the caller's own
    // parents/spouse/children array on an existing document — and only if
    // that id belongs to a person the caller themself just created. This
    // is what lets a create() be immediately followed by the reverse-link
    // update without opening a general "re-link any two people" hole,
    // which stays admin-only.
    function relationshipAdditionIsValid() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return (
        (changed.hasOnly(['spouse']) && after.spouse.size() == before.spouse.size() + 1
          && before.spouse.hasAll(before.spouse) && after.spouse.hasAll(before.spouse)
          && callerAddedPerson(after.spouse.removeAll(before.spouse)[0]))
        ||
        (changed.hasOnly(['children']) && after.children.size() == before.children.size() + 1
          && after.children.hasAll(before.children)
          && callerAddedPerson(after.children.removeAll(before.children)[0]))
        ||
        (changed.hasOnly(['parents']) && after.parents.size() == before.parents.size() + 1
          && after.parents.hasAll(before.parents)
          && callerAddedPerson(after.parents.removeAll(before.parents)[0]))
      );
    }

    function callerAddedPerson(personId) {
      let me = callerPerson();
      return me != null
        && exists(/databases/$(database)/documents/people/$(personId))
        && get(/databases/$(database)/documents/people/$(personId)).data.addedBy == me.nahar_id;
    }

    // The private/details read boundary: admin, or any matched member
    // (deliberately not relatives-only — see the file header). Factored
    // out as its own function so the nested people/{naharId}/private/
    // details rule and the top-level collectionGroup wildcard rule below
    // can never drift apart — they call this exact same check, not two
    // independently-maintained copies of it.
    function canReadPrivateDetails() {
      return isAdmin() || callerPerson() != null;
    }

    match /people/{naharId} {
      // Public shape only — no phone/email/DOB/location/etc. here, so
      // requiring only "signed in" (not "matched") is safe: this is what
      // lets an unmatched visitor's claim form and the tree/directory
      // shape work before they're approved, without exposing anyone's
      // contact details to a stranger who just made a Google account.
      allow read: if signedInEmail() != null;

      allow create: if isAdmin() || (
        signedInEmail() != null
        && newPersonBaseShapeIsValid(naharId, request.resource.data)
        && (
          newParentIsValid(request.resource.data) ||
          newSpouseIsValid(request.resource.data) ||
          newChildIsValid(request.resource.data) ||
          newLinkedFamilyRootIsValid(request.resource.data)
        )
      );

      allow update: if signedInEmail() != null
        && canEditPerson(naharId, resource.data)
        && (isAdmin() || onlyPublicPersonalFieldsChanged() || relationshipAdditionIsValid());

      allow delete: if isAdmin();

      // The actually-sensitive fields — see the file header. Readable only
      // by an admin or any matched member (not merely "signed in"), which
      // is the real privacy boundary this whole split exists to enforce.
      match /private/details {
        allow read: if canReadPrivateDetails();

        // Created in the same two-write pattern as the parent Person (see
        // the file header) — by whoever is creating naharId itself, i.e.
        // anyone who could create the parent doc under the same rules.
        allow create: if isAdmin() || (
          signedInEmail() != null
          && exists(/databases/$(database)/documents/people/$(naharId))
          && get(/databases/$(database)/documents/people/$(naharId)).data.addedBy == callerPerson().nahar_id
        );

        allow update: if signedInEmail() != null
          && exists(/databases/$(database)/documents/people/$(naharId))
          && canEditPerson(naharId, get(/databases/$(database)/documents/people/$(naharId)).data)
          && (isAdmin() || onlyPrivateFieldsChanged());

        allow delete: if isAdmin();
      }
    }

    // Firestore rule scoping gotcha, documented here so it's never
    // "silently re-broken": the nested `match /people/{naharId}/private/
    // details` rule above governs reads that go through that exact path
    // (a single getDoc(), or a query scoped to one person's own private
    // subcollection) — it does NOT automatically cover a collectionGroup()
    // query across every person's private/details doc at once, which is
    // what src/lib/dataSource.ts uses to fetch everyone's private fields
    // in one round trip. A collectionGroup query needs its own top-level
    // wildcard rule to be evaluated against at all; without this block,
    // such a query is denied outright regardless of the nested rule
    // above, which is exactly the bug this comment exists to prevent
    // recurring. Delegates to the same canReadPrivateDetails() the nested
    // rule uses, so the two can never drift into different boundaries.
    match /{path=**}/private/{document} {
      allow read: if canReadPrivateDetails();
    }

    // Sequential-id reservation counter, incremented inside the same
    // client-side transaction that creates a new person — guarantees
    // collision-safe "N-00xx" ids without a Cloud Function. A signed-in
    // linked member may only ever increment by exactly 1; going backward,
    // skipping ids, or writing arbitrary values is rejected. A buggy or
    // malicious client could burn an id without creating a person (ids are
    // already never reused/renumbered by convention, so this is harmless);
    // it cannot cause two people to collide on the same id, which is the
    // actual risk this exists to prevent.
    match /meta/id_counter {
      allow read: if true;
      allow update: if signedInEmail() != null
        && callerPerson() != null
        && request.resource.data.nextSeq == resource.data.nextSeq + 1;
    }

    // A signed-in-but-unmatched visitor's self-service request to be linked
    // to an existing Person. Doc id is the claimant's own lowercased email
    // — at most one claim per email, and only ever created by that same
    // person (never by someone else on their behalf). Only an admin may
    // change status/reviewedBy/reviewedAt (the approve/reject action) or
    // delete a claim (e.g. to clear a rejected one so its owner can retry).
    // Approving a claim itself just means the admin then does the existing
    // people_by_email link — this collection carries no elevated rights of
    // its own, it's purely a request queue for the admin to act on.
    match /pending_claims/{claimId} {
      allow read: if isAdmin() || (signedInEmail() != null && claimId == signedInEmail());

      allow create: if signedInEmail() != null
        && claimId == signedInEmail()
        && request.resource.data.email == signedInEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.submittedAt == request.time
        && request.resource.data.submittedName is string && request.resource.data.submittedName.size() > 0
        && request.resource.data.fatherName is string && request.resource.data.fatherName.size() > 0
        && request.resource.data.motherName is string && request.resource.data.motherName.size() > 0;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /people_by_email/{email} {
      // Nobody needs to read someone ELSE's email-to-id mapping
      // client-side — the app only ever looks up its own signed-in user's
      // email (AuthContext) or an admin acting on a specific known email
      // (AdminPage). Scoping this to "your own email, or an admin" closes
      // the scrape-every-real-email-address hole a blanket
      // request.auth != null left open.
      allow read: if isAdmin() || (signedInEmail() != null && email == signedInEmail());
      allow write: if signedInEmail() != null && (
        isAdmin() ||
        (
          // Case 1: pointing a lookup at MY OWN email — must target a
          // nahar_id I'm already authorized to edit (self-link, or
          // relinking after an edit to my own record's email).
          email == signedInEmail() &&
          exists(/databases/$(database)/documents/people/$(request.resource.data.nahar_id)) &&
          canEditPerson(
            request.resource.data.nahar_id,
            get(/databases/$(database)/documents/people/$(request.resource.data.nahar_id)).data
          )
        ) ||
        (
          // Case 2: registering the email lookup for a person I just
          // created (real or placeholder address) — same trust boundary
          // as relationshipAdditionIsValid()'s callerAddedPerson check.
          exists(/databases/$(database)/documents/people/$(request.resource.data.nahar_id)) &&
          get(/databases/$(database)/documents/people/$(request.resource.data.nahar_id)).data.addedBy
            == callerPerson().nahar_id
        )
      );
    }
  }
}
